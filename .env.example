# Supabase (usado por apps/web e workers/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # somente no Worker, nunca no front-end

# Front-end (Vite exige prefixo VITE_ para expor ao client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8787

# Worker (Cloudflare) — LLM
LLM_PROVIDER=gemini          # "gemini" | "anthropic" — ver src/lib/llm/provider.ts
LLM_MODEL=gemini-2.0-flash   # precisa bater com o provedor acima
GEMINI_API_KEY=...           # necessário se LLM_PROVIDER=gemini — console.cloud.google.com/apis ou aistudio.google.com
ANTHROPIC_API_KEY=sk-ant-... # necessário se LLM_PROVIDER=anthropic

# CORS
ALLOWED_ORIGIN=http://localhost:5173
