# Supabase (usado por apps/web e workers/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # somente no Worker, nunca no front-end

# Front-end (Vite exige prefixo VITE_ para expor ao client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8787

# Worker (Cloudflare) — LLM
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-4-8

# CORS
ALLOWED_ORIGIN=http://localhost:5173
