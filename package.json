{
  "name": "belledecide",
  "private": true,
  "version": "0.1.0",
  "description": "Belle decide — PWA que elimina a carga mental doméstica do planejamento alimentar",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @belledecide/web dev",
    "dev:api": "pnpm --filter @belledecide/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
